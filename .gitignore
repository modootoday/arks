# Specfold local / build (public-repo: never commit local/agent scratch)
.spec.local/
.specfold/
target/
target-*/
.cargo-target/
verify/out/
verify/gates/*/out/
verify/gates/*/.run.lock.dir/

# Local CI / agent scratch dumps (never commit)
/_win_*.log
*.bak
*.agent-dump.*
*.evidence
**/agent-transcripts/

