# Specfold local / build (public-repo: never commit local/agent scratch)
.spec.local/
.specfold/
target/
target-*/
.cargo-target/
verify/out/
verify/gates/*/out/
verify/gates/*/.run.lock.dir/

# Local CI / agent scratch dumps (never commit)
/_win_*.log
*.bak
*.agent-dump.*
*.evidence
**/agent-transcripts/

# Secrets / credentials (public-surface: never commit)
.env
.env.*
!.env.example
*.pem
*.p12
id_rsa
id_ed25519
credentials.json
**/secrets/

# OS / editor
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Gate-local cargo spill (clean-room uses compose volume)
verify/gates/*/target/

