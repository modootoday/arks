{
  "env": {
    "PLAYPILOT_PROTECTED_BRANCHES": "main"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'command -v playpilot >/dev/null 2>&1 || for c in cargo /root/.cargo/bin/cargo \"$HOME/.cargo/bin/cargo\"; do command -v \"$c\" >/dev/null 2>&1 && \"$c\" install --locked --quiet --git https://github.com/modootoday/playpilot --rev 39918859deb3a63987bd0a19ebfb841ec84e4e13 playpilot >&2 && break; done; command -v playpilot >/dev/null 2>&1 || [ -x \"$HOME/.cargo/bin/playpilot\" ] || { echo \"playpilot CLI is missing and could not be installed\" >&2; exit 2; }; exec \"$(command -v playpilot || echo \"$HOME/.cargo/bin/playpilot\")\" guard'",
            "timeout": 240
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(cargo *)",
      "Bash(rustup *)",
      "Bash(rustc *)",
      "Bash(bash verify/*)",
      "Bash(python3 -I verify/*)",
      "Bash(sh verify/*)",
      "Bash(docker compose *)",
      "Bash(docker ps*)",
      "Bash(docker images*)",
      "Bash(docker logs *)",
      "Bash(playpilot *)",
      "Bash(target/debug/arks *)",
      "Bash(target/release/arks *)",
      "Bash(arks *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git blame*)",
      "Bash(git grep*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git cherry-pick *)",
      "Bash(git rebase *)",
      "Bash(git restore *)",
      "Bash(git stash*)",
      "Bash(git worktree *)",
      "Bash(git branch*)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git merge --no-edit FETCH_HEAD)",
      "Bash(git push -u origin claude/*)",
      "Bash(git push origin claude/*)",
      "Bash(git push --force-with-lease=claude/* origin claude/*)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(diff *)",
      "Bash(jq *)",
      "Bash(sed -n *)",
      "Bash(mkdir *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(date*)",
      "Bash(which *)",
      "Bash(command -v *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(true)",
      "Read(**)",
      "Edit(crates/**)",
      "Edit(verify/**)",
      "Edit(docs/**)",
      "Edit(.spec/**)",
      "Edit(.agents/skills/**)",
      "Edit(README.md)",
      "Edit(Cargo.lock)"
    ],
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push * main)",
      "Bash(git push * main:*)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push * refs/heads/main*)",
      "Bash(git push --tags*)",
      "Bash(git push * --tags*)",
      "Bash(git push * refs/tags/*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * -f)",
      "Bash(git push --mirror*)",
      "Bash(git push * --delete *)",
      "Bash(arks push origin main*)",
      "Bash(arks push * main)",
      "Bash(arks push --force *)",
      "Bash(git config --global *)",
      "Bash(git config --system *)",
      "Bash(git config user.*)",
      "Bash(git update-ref * refs/heads/main*)",
      "Bash(git reset --hard origin/main)",
      "Bash(cargo publish*)",
      "Bash(cargo login*)",
      "Bash(cargo owner*)",
      "Bash(cargo yank*)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(chmod -R 777 *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.config/gh/**)",
      "Read(~/.cargo/credentials*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(.claude/settings*.json)",
      "Write(.claude/settings*.json)",
      "Edit(.cursor/hooks*)",
      "Write(.cursor/hooks*)",
      "Edit(.cursor/hooks/**)",
      "Write(.cursor/hooks/**)",
      "Edit(.spec.local/**)",
      "Write(.spec.local/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
